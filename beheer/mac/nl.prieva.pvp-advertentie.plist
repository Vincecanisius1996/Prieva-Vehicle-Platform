<!--
  Draait pvp-advertentie-runner.sh elk half uur, maandag t/m zaterdag tussen 08:00 en 18:00.

  Waarom die uren en niet de klok rond: er moet een mens in de buurt zijn die kan ingrijpen als
  Mobilox iets onverwachts doet, en Chrome moet open en ingelogd staan. Dezelfde gedachte als bij
  de Mobilox-koppeling op de server, die ook alleen tijdens werkuren loopt.

  Elk half uur en niet vaker: een advertentie maken duurt minuten, niet seconden, en er komen er
  geen tien per uur bij.

  Installeren:
    cp nl.prieva.pvp-advertentie.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/nl.prieva.pvp-advertentie.plist
  Stoppen:
    launchctl unload ~/Library/LaunchAgents/nl.prieva.pvp-advertentie.plist
  Een keer met de hand draaien:
    launchctl start nl.prieva.pvp-advertentie
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>nl.prieva.pvp-advertentie</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>$HOME/bin/pvp-advertentie-runner.sh</string>
  </array>

  <!-- Elk half uur, ma t/m za, 08:00-18:00. StartCalendarInterval neemt een lijst momenten. -->
